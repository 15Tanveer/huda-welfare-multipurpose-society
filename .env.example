# ---------------------------------------------------------------------------
# HUDA Welfare & Educational Multipurpose Society — environment variables
#
# Copy this file to `.env.local` for local development and fill in the
# values from your Supabase project (Project Settings → API).
# ---------------------------------------------------------------------------

# Public Supabase project URL. Safe to expose to the browser.
# Example: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose to the browser — access is enforced by
# the Row Level Security policies in supabase/migrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER expose this to the browser or commit it anywhere.
# Only used server-side (see src/lib/supabase/admin.ts) and only where the
# anon key + RLS genuinely cannot express the required access.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL this site is deployed at (used for canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags).
# Local development example: http://localhost:3000
# Production example: https://www.hudawelfare.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
